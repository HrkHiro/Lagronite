}

model LostItem {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  itemName     String
  category     String
  color        String
  description  String
  dateLost     DateTime
  locationLost String
  image        String
  ownerId      String       @db.ObjectId
  owner        User         @relation("LostItemOwner", fields: [ownerId], references: [id])
  status       ReportStatus @default(Lost)
  claimerName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model FoundItem {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  itemName      String
  category      String
  color         String
  description   String
  dateFound     DateTime
  locationFound String
  image         String
  finderId      String       @db.ObjectId
  finder        User         @relation("FoundItemFinder", fields: [finderId], references: [id])
  status        ReportStatus @default(Found)
  claimerName   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ItemComment {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  itemType  ReportType
  itemId    String     @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([itemType, itemId, createdAt])
}

model ItemReaction {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  itemType     ReportType
  itemId       String       @db.ObjectId
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id])
  reactionType ReactionType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([itemType, itemId, userId])
  @@index([itemType, itemId])
}

model ReportChat {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  reportType   ReportType
  reportId     String                  @db.ObjectId
  isClosed     Boolean                 @default(false)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants ReportChatParticipant[]
  messages     ChatMessage[]

  @@unique([reportType, reportId])
}

model ReportChatParticipant {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  chatId String     @db.ObjectId
  userId String     @db.ObjectId
  chat   ReportChat @relation(fields: [chatId], references: [id])
  user   User       @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model ChatMessage {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  chatId    String     @db.ObjectId
  senderId  String     @db.ObjectId
  text      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chat      ReportChat @relation(fields: [chatId], references: [id])
  sender    User       @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}
