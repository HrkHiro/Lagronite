generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum UserRole {
  student
  admin
}

enum UserStatus {
  active
  suspended
  banned
}

enum ReportStatus {
  Lost
  Found
  Claimed
  Returned
}

enum ReportType {
  lost
  found
}

enum ReactionType {
  like
  helpful
  interested
}

